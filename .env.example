# ===== 应用 =====
# 数据库文件路径(相对项目根目录)
AIMAP_DB_PATH = data/aimap.db
# 允许的 CORS 来源(前端开发服务器地址,逗号分隔)
AIMAP_CORS_ORIGINS = *

# ===== LLM Provider(后续提供 API key 后填写;留空时系统自动回落 Mock Provider)=====
# 选择 provider: mock | openai | deepseek
AIMAP_LLM_PROVIDER = mock
AIMAP_LLM_MODEL = gpt-4o-mini
OPENAI_API_KEY =
OPENAI_BASE_URL = https://api.openai.com/v1
DEEPSEEK_API_KEY =
DEEPSEEK_BASE_URL = https://api.deepseek.com/v1

# ===== 图书馆账号(预留,后续提供账号后填写)=====
# 支持 IEEE / ACM / 知网(CNKI);未配置时相关爬虫保持禁用
LIB_IEEE_ACCOUNT =
LIB_IEEE_PASSWORD =
LIB_ACM_ACCOUNT =
LIB_ACM_PASSWORD =
LIB_CNKI_ACCOUNT =
LIB_CNKI_PASSWORD =

# ===== 爬虫 =====
# arXiv 请求间隔(秒),遵守限流
AIMAP_ARXIV_DELAY = 3.0
AIMAP_ARXIV_MAX_RESULTS = 200
# arXiv API 端点(默认官方;网络受限时可通过 HTTP 代理环境变量 HTTPS_PROXY 或改用镜像端点)
AIMAP_ARXIV_API = https://export.arxiv.org/api/query
# 图书馆登录会话有效期(小时,默认 7 天)
AIMAP_SESSION_TTL_HOURS = 168

# ===== 爬虫资源获取规范(所有数据源统一)=====
# 每来源最小请求间隔(秒)
AIMAP_CRAWL_MIN_INTERVAL = 3.0
# 可恢复错误(429/5xx/超时)最大重试次数
AIMAP_CRAWL_MAX_RETRIES = 3
# 指数退避基数与上限(秒)
AIMAP_CRAWL_BACKOFF_BASE = 2.0
AIMAP_CRAWL_BACKOFF_MAX = 60.0
# 熔断:连续失败阈值与冷却时间(秒)
AIMAP_CRAWL_CIRCUIT_THRESHOLD = 5
AIMAP_CRAWL_CIRCUIT_COOLDOWN = 300.0
