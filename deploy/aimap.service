[Unit]
Description=AIMap - AI Paper Domain Map (crawler + analysis + API)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/aimap
EnvironmentFile=/opt/aimap/.env
ExecStart=/opt/aimap/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
# 安全加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/aimap/data

[Install]
WantedBy=multi-user.target
